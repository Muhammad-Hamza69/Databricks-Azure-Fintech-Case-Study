  create or replace view `clickstream`.`gold`.`export_visitor_engagement_salesforce`
  
  as (
    -- Stable contract for the Fivetran reverse-ETL sync into Salesforce (Visitor_Engagement__c).
-- Column names/types here are the sync's source of truth - if gold_visitor_summary's internal
-- shape changes, this view is the one place to adjust so the Salesforce field mapping doesn't
-- silently break. visitor_id is the upsert/match key (mapped to the Visitor_Id__c external ID
-- field in Salesforce).
select
    visitor_id,
    total_views,
    total_addtocarts,
    total_transactions,
    distinct_items_viewed,
    first_seen,
    last_seen,
    is_converted
from `clickstream`.`gold`.`gold_visitor_summary`
  )

